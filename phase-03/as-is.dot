digraph process {
graph [rankdir=TB,bgcolor="white",pad="0.25",nodesep="0.3",ranksep="0.45"];
node [shape=box,style="rounded,filled",fillcolor="#eaf3f7",color="#397187",fontname="DejaVu Sans",fontsize=11];
edge [color="#607887",fontname="DejaVu Sans",fontsize=10];
A [label="Sales: receive customer order",shape=box];
B [label="Data and price correct?",shape=diamond];
A -> B [label="",style=solid];
C [label="Sales: request correction / retain draft",shape=box];
B -> C [label="No",style=solid];
C -> B [label="",style=solid];
D [label="Finance: credit or order block?",shape=diamond];
B -> D [label="Yes",style=solid];
E [label="Responsible owner reviews / no dispatch",shape=box];
D -> E [label="Yes",style=solid];
E -> D [label="",style=solid];
F [label="Sales asks Warehouse about stock",shape=box];
D -> F [label="No",style=solid];
G [label="Enough stock?",shape=diamond];
F -> G [label="",style=solid];
H [label="Customer agrees partial?",shape=diamond];
G -> H [label="No",style=solid];
I [label="Sales: wait / revise promise",shape=box];
H -> I [label="No",style=solid];
I -> F [label="",style=solid];
J [label="Warehouse: pick permitted quantity / remainder open",shape=box];
H -> J [label="Yes",style=solid];
G -> J [label="Yes",style=solid];
K [label="Warehouse: dispatch physically",shape=box];
J -> K [label="",style=solid];
L [label="Warehouse: enter stock movement and email Finance",shape=box];
K -> L [label="",style=solid];
M [label="Finance waits for handoff and creates invoice",shape=box];
L -> M [label="",style=solid];
N [label="Invoice correct?",shape=diamond];
M -> N [label="",style=solid];
O [label="Finance: review linked correction",shape=box];
N -> O [label="No",style=solid];
O -> M [label="",style=solid];
P [label="Finance receives payment",shape=box];
N -> P [label="Yes",style=solid];
Q [label="Full supported match?",shape=diamond];
P -> Q [label="",style=solid];
R [label="Finance: partial or unmatched balance review",shape=box];
Q -> R [label="No",style=solid];
S [label="Customer Service / IT consolidate reporting",shape=box];
R -> S [label="",style=solid];
Q -> S [label="Yes",style=solid];
T [label="Already dispatched?",shape=diamond];
A -> T [label="Cancellation request",style=dashed];
U [label="Sales checks dependencies and stops demand",shape=box];
T -> U [label="No",style=solid];
V [label="Finance / Warehouse: return or reversal review",shape=box];
T -> V [label="Yes",style=solid];
U -> S [label="",style=solid];
V -> S [label="",style=solid];
}